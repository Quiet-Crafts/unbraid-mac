#!/usr/bin/env python3
"""Guard for the public repository: refuses the pre-publication history, and any commit whose tree holds internal,
secret or build-output paths. Anything it can't read is refused too.
Install once per clone: git config core.hooksPath tools/hooks   Tests: python3 tools/hooks/test_pre_push.py"""
import re
import subprocess
import sys

# The first commit of the history kept private: nothing built on it is pushed.
OLD_ROOT = "8cf8c446533df15916f84b23a050e1f5570df040"
BAD = re.compile(
    r"(^|/)(_INTERNAL|docs|\.secrets|secrets?|\.claude|build|dist|DerivedData|xcuserdata|Libbox\.xcframework)/"
    r"|(^|/)(CHANGELOG\.md|AGENTS\.md|CLAUDE\.md|\.DS_Store|\.env(\.[^/]*)?|id_(rsa|dsa|ecdsa|ed25519)(\.pub)?)$"
    r"|\.(p8|p12|pfx|pem|key|cer|ppk|jks|keystore|asc|gpg|kdbx|mobileprovision|provisionprofile|mobileconfig"
    r"|xcarchive|dmg|ipa|conf|ovpn|bundle|xcconfig)$"
    r"|\.xcarchive/|-source\.tar\.gz$", re.IGNORECASE)
# Allowed despite the list: the signing settings everyone shares, and the synthetic configs the import tests read.
ALLOWED = re.compile(r"^Config/Signing\.xcconfig$|^Tests/Fixtures/ovpn/[^/]+\.ovpn$")
# Private keys may appear only in the tests' synthetic data.
KEY = r"BEGIN [A-Z ]*PRIVATE KEY"


def git(*args, ok=(0,)):
    # Replacement refs could show a clean stand-in for what the push actually sends.
    r = subprocess.run(["git", "--no-replace-objects", *args], capture_output=True)
    if r.returncode not in ok:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.decode(errors='replace').strip()}")
    return r


def commit_of(sha):
    kind = git("cat-file", "-t", sha).stdout.decode().strip()
    if kind == "tag":
        sha = git("rev-parse", f"{sha}^{{}}").stdout.decode().strip()
        kind = git("cat-file", "-t", sha).stdout.decode().strip()
    if kind != "commit":
        raise RuntimeError(f"{sha} is a {kind}, not a commit")
    return sha


def problems(lref, lsha):
    if git("rev-parse", "--is-shallow-repository").stdout.strip() != b"false":
        raise RuntimeError("a shallow clone can't show the whole history")
    sha = commit_of(lsha)
    if git("cat-file", "-e", OLD_ROOT, ok=(0, 1, 128)).returncode == 0 and \
            git("merge-base", "--is-ancestor", OLD_ROOT, sha, ok=(0, 1)).returncode == 0:
        return [f"{lref} is built on the pre-publication history"]
    out = []
    for c in git("rev-list", sha).stdout.decode().split():
        hits, links = [], []
        for entry in git("ls-tree", "-r", "-z", c).stdout.decode(errors="surrogateescape").split("\0"):
            if not entry:
                continue
            meta, name = entry.split("\t", 1)
            mode, _, blob = meta.split()
            if BAD.search(name) and not ALLOWED.fullmatch(name):
                hits.append(name)
            elif mode == "120000":
                # A link publishes its target's name: only relative links that stay inside the repository.
                target = git("cat-file", "blob", blob).stdout.decode(errors="surrogateescape")
                if target.startswith("/") or target.startswith("~") or ".." in target.split("/") or BAD.search(target):
                    links.append(f"{name} -> {target}")
        if hits:
            out.append(f"{c} ({lref}) contains internal or secret paths: " + ", ".join(map(repr, hits[:5])))
        if links:
            out.append(f"{c} ({lref}) links outside the repository: " + ", ".join(map(repr, links[:5])))
        keys = git("grep", "-l", "-I", "-E", KEY, c, "--", ".", ":!Tests/", ok=(0, 1)).stdout.decode(errors="replace").split()
        if keys:
            out.append(f"{c} ({lref}) holds a private key outside the tests: " + ", ".join(k.split(":", 1)[-1] for k in keys[:5]))
    return out


def main():
    status = 0
    for line in sys.stdin:
        parts = line.split()
        if not parts:
            continue
        try:
            lref, lsha = parts[0], parts[1]
            if set(lsha) == {"0"}:
                continue  # a deletion publishes nothing
            found = problems(lref, lsha)
        except (IndexError, RuntimeError) as e:
            found = [f"can't check {line.strip()!r}: {e}"]
        for p in found:
            print(f"pre-push: {p}; not pushing.", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
