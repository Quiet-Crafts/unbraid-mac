+package openvpn
+
+import (
+	"net/netip"
+	"testing"
+	"time"
+)
+
+// Unbraid: a server can't hold a stop with explicit-exit-notify, nor get a filtered option past a pull filter by its case
+// or quoting.
+
+func TestExplicitExitNotifyIsBounded(t *testing.T) {
+	for _, c := range []struct {
+		count, sent int
+		slow        bool
+	}{
+		{count: 0, sent: 0},
+		{count: 1, sent: 1},
+		{count: 3600, sent: explicitExitNotifyMaxTries},
+		{count: 1 << 30, sent: explicitExitNotifyMaxTries, slow: true},
+	} {
+		start := time.Now()
+		sent := 0
+		notifyExplicitExit(c.count, func(tick time.Duration) {
+			if tick <= 0 || tick > explicitExitNotifyInterval {
+				t.Errorf("count %d: tick %v", c.count, tick)
+			}
+			sent++
+			if c.slow {
+				time.Sleep(tick)
+			}
+		})
+		elapsed := time.Since(start)
+		if sent != c.sent {
+			t.Errorf("count %d: sent %d", c.count, sent)
+		}
+		if elapsed > explicitExitNotifyWindow+200*time.Millisecond {
+			t.Errorf("count %d: took %v", c.count, elapsed)
+		}
+	}
+}
+
+func decodeFiltered(line string, filters []PullFilter) pushedOptions {
+	options, _ := decodePushReplyOptionLines("PUSH_REPLY", []string{line}, netip.Addr{}, filters)
+	return options
+}
+
+func TestPullFiltersIgnoreCaseAndQuoting(t *testing.T) {
+	filters := []PullFilter{{Action: "ignore", Text: "explicit-exit-notify"}, {Action: "accept", Text: "route 10.8."}, {Action: "ignore", Text: "route"}, {Action: "reject", Text: "dhcp-option"}}
+	for _, line := range []string{"explicit-exit-notify 3600", "EXPLICIT-EXIT-NOTIFY 3600", `"explicit-exit-notify" 3600`, `'Explicit-Exit-Notify' 3600`, "  explicit-exit-notify\t3600"} {
+		options := decodeFiltered(line, filters)
+		if options.ExplicitExitNotifySet || options.pullFilterRejection != "" {
+			t.Errorf("%q: set %v, rejection %q", line, options.ExplicitExitNotifySet, options.pullFilterRejection)
+		}
+	}
+	for _, c := range []struct {
+		line   string
+		routes int
+	}{
+		{"route 10.8.0.0 255.255.0.0", 1},
+		{`"route" 10.8.0.0 255.255.0.0`, 1},
+		{"ROUTE\t10.8.0.0 255.255.0.0", 1},
+		{"ROUTE 0.0.0.0 0.0.0.0", 0},
+		{`"Route" 192.168.1.0 255.255.255.0`, 0},
+		{"route 192.168.1.0 255.255.255.0 # comment", 0},
+	} {
+		options := decodeFiltered(c.line, filters)
+		if len(options.Routes) != c.routes || options.pullFilterRejection != "" {
+			t.Errorf("%q: routes %v, rejection %q", c.line, options.Routes, options.pullFilterRejection)
+		}
+	}
+	for _, line := range []string{"dhcp-option DNS 1.1.1.1", "DHCP-OPTION DNS 1.1.1.1", `"dhcp-option" DNS 1.1.1.1`} {
+		if decodeFiltered(line, filters).pullFilterRejection == "" {
+			t.Errorf("%q: not rejected", line)
+		}
+	}
+	if options := decodeFiltered("topology subnet", filters); options.Topology != "subnet" {
+		t.Errorf("unfiltered option lost: %q", options.Topology)
+	}
+}
+
+// What a filter's own arguments say is kept exactly, and the first filter that matches still decides.
+func TestPullFiltersKeepTheirOrderAndArguments(t *testing.T) {
+	user := []PullFilter{{Action: "accept", Text: "auth-token-user Alice"}, {Action: "reject", Text: "auth-token-user"}}
+	if decodeFiltered("auth-token-user alice", user).pullFilterRejection == "" {
+		t.Error("an argument in another case matched the accept")
+	}
+	if decodeFiltered("AUTH-TOKEN-USER Alice", user).pullFilterRejection != "" {
+		t.Error("the accept didn't match its own argument")
+	}
+	tabbed := []PullFilter{{Action: "ignore", Text: "dhcp-option\tDNS"}}
+	if options := decodeFiltered("DHCP-OPTION\tDNS 1.1.1.1", tabbed); len(options.DHCPOptions) != 0 {
+		t.Errorf("a filter with a tab didn't match: %v", options.DHCPOptions)
+	}
+	spaced := []PullFilter{{Action: "accept", Text: "route  10.8."}, {Action: "reject", Text: "route"}}
+	if options := decodeFiltered("route  10.8.0.0 255.255.0.0", spaced); options.pullFilterRejection != "" || len(options.Routes) != 1 {
+		t.Errorf("the accept written for the raw line no longer matched it: %q", options.pullFilterRejection)
+	}
+	if decodeFiltered("route 192.168.1.0 255.255.255.0", spaced).pullFilterRejection == "" {
+		t.Error("the reject no longer applies")
+	}
+}
