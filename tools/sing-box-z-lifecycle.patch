--- /dev/null
+++ b/daemon/quality_lifecycle_test.go
@@ -0,0 +1,91 @@
+package daemon
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/trafficcontrol"
+	"github.com/sagernet/sing/common/observable"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type qualityStream[T any] struct{ grpc.ServerStream }
+
+func (qualityStream[T]) Context() context.Context { return context.Background() }
+func (qualityStream[T]) Send(*T) error            { return nil }
+
+func TestQualityTestsReturnUnavailableAfterInstanceCloses(t *testing.T) {
+	service := &StartedService{serviceStatus: &ServiceStatus{Status: ServiceStatus_STARTED}}
+	if err := service.StartSTUNTest(&STUNTestRequest{}, qualityStream[STUNTestProgress]{}); status.Code(err) != codes.Unavailable {
+		t.Fatalf("STUN: %v", err)
+	}
+	if err := service.StartNetworkQualityTest(&NetworkQualityTestRequest{}, qualityStream[NetworkQualityTestProgress]{}); status.Code(err) != codes.Unavailable {
+		t.Fatalf("network quality: %v", err)
+	}
+	if err := service.SubscribeConnections(&SubscribeConnectionsRequest{}, qualityStream[ConnectionEvents]{}); status.Code(err) != codes.Unavailable {
+		t.Fatalf("connections: %v", err)
+	}
+}
+
+// A reload publishes the next instance before starting it: a stream that waited for the old one must not take it.
+func TestConnectionsRefuseAnInstanceStillStarting(t *testing.T) {
+	subscriber := observable.NewSubscriber[*ServiceStatus](4)
+	service := &StartedService{
+		ctx:                     context.Background(),
+		serviceStatus:           &ServiceStatus{Status: ServiceStatus_STARTING},
+		serviceStatusSubscriber: subscriber,
+		serviceStatusObserver:   observable.NewObserver(subscriber, 2),
+		instance:                &Instance{trafficManager: trafficcontrol.NewManager()},
+	}
+	t.Cleanup(func() { _ = service.serviceStatusObserver.Close() })
+	done := make(chan error, 1)
+	go func() {
+		done <- service.SubscribeConnections(&SubscribeConnectionsRequest{}, qualityStream[ConnectionEvents]{})
+	}()
+	for {
+		select {
+		case err := <-done:
+			if status.Code(err) != codes.Unavailable {
+				t.Fatalf("connections: %v", err)
+			}
+			return
+		case <-time.After(10 * time.Millisecond):
+			subscriber.Emit(&ServiceStatus{Status: ServiceStatus_STARTED})
+		}
+	}
+}
+
+func TestTailscaleCommandsReturnUnavailableAfterInstanceCloses(t *testing.T) {
+	service := &StartedService{serviceStatus: &ServiceStatus{Status: ServiceStatus_STARTED}}
+	ctx := context.Background()
+	for _, tag := range []string{"ts", ""} {
+		if _, err := service.TailscaleLogout(ctx, &TailscaleLogoutRequest{EndpointTag: tag}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("logout %q: %v", tag, err)
+		}
+		if _, err := service.SetTailscaleExitNode(ctx, &SetTailscaleExitNodeRequest{EndpointTag: tag}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("exit node %q: %v", tag, err)
+		}
+		if _, err := service.GetTailscaleCertificate(ctx, &TailscaleCertificateRequest{EndpointTag: tag}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("certificate %q: %v", tag, err)
+		}
+		if err := service.StartTailscalePing(&TailscalePingRequest{EndpointTag: tag}, qualityStream[TailscalePingResponse]{}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("ping %q: %v", tag, err)
+		}
+		if _, err := service.MarkTaildropInboxRead(ctx, &MarkTaildropInboxReadRequest{EndpointTag: tag}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("mark read %q: %v", tag, err)
+		}
+		if _, err := service.DeleteTaildropFile(ctx, &DeleteTaildropFileRequest{EndpointTag: tag}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("delete %q: %v", tag, err)
+		}
+		if _, err := service.CancelTaildropReceiving(ctx, &CancelTaildropReceivingRequest{EndpointTag: tag}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("cancel receiving %q: %v", tag, err)
+		}
+		if err := service.DownloadTaildropFile(&DownloadTaildropFileRequest{EndpointTag: tag}, qualityStream[DownloadTaildropFileChunk]{}); status.Code(err) != codes.Unavailable {
+			t.Fatalf("download %q: %v", tag, err)
+		}
+	}
+}
