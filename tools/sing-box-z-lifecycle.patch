diff --git a/experimental/libbox/config_cleanup_test.go b/experimental/libbox/config_cleanup_test.go
new file mode 100644
index 0000000..ec52824
--- /dev/null
+++ b/experimental/libbox/config_cleanup_test.go
@@ -0,0 +1,49 @@
+//go:build with_gvisor && with_wireguard
+
+package libbox
+
+import (
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCheckConfigClosesWireGuardStack(t *testing.T) {
+	config := `{"endpoints":[{"type":"wireguard","tag":"wg","address":["10.0.0.2/32"],"private_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","peers":[{"address":"127.0.0.1","port":51820,"public_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","allowed_ips":["0.0.0.0/0"]}]}]}`
+	if err := CheckConfig(config); err != nil {
+		t.Fatal(err)
+	}
+	runtime.GC()
+	before := runtime.NumGoroutine()
+	for i := 0; i < 12; i++ {
+		if err := CheckConfig(config); err != nil {
+			t.Fatal(err)
+		}
+	}
+	runtime.GC()
+	time.Sleep(100 * time.Millisecond)
+	if after := runtime.NumGoroutine(); after > before+8 {
+		t.Fatalf("goroutines grew from %d to %d", before, after)
+	}
+}
+
+func TestFailedCheckConfigClosesConstructedEndpoints(t *testing.T) {
+	endpoint := `{"type":"wireguard","tag":"wg","address":["10.0.0.2/32"],"private_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","peers":[{"address":"127.0.0.1","port":51820,"public_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","allowed_ips":["0.0.0.0/0"]}]}`
+	config := `{"endpoints":[` + strings.Join([]string{endpoint, endpoint}, ",") + `]}`
+	if err := CheckConfig(config); err == nil {
+		t.Fatal("duplicate tag accepted")
+	}
+	runtime.GC()
+	before := runtime.NumGoroutine()
+	for i := 0; i < 12; i++ {
+		if err := CheckConfig(config); err == nil {
+			t.Fatal("duplicate tag accepted")
+		}
+	}
+	runtime.GC()
+	time.Sleep(100 * time.Millisecond)
+	if after := runtime.NumGoroutine(); after > before+8 {
+		t.Fatalf("goroutines grew from %d to %d", before, after)
+	}
+}
