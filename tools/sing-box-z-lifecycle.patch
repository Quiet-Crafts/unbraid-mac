--- a/adapter/endpoint/manager.go
+++ b/adapter/endpoint/manager.go
@@ -71,9 +71,21 @@ func (m *Manager) Create(ctx context.Context, router adapter.Router, logger log.
 	defer m.access.Unlock()
 	_, loaded := m.endpointByTag[tag]
 	if loaded {
+		if closer, ok := endpoint.(interface{ CloseBeforeStart() error }); ok {
+			_ = closer.CloseBeforeStart()
+		}
 		return E.New("duplicate endpoint tag: ", tag)
 	}
 	m.endpoints = append(m.endpoints, endpoint)
 	m.endpointByTag[tag] = endpoint
 	return nil
 }
+
+// CloseBeforeStart releases resources allocated by endpoint constructors.
+func (m *Manager) CloseBeforeStart() {
+	for _, endpoint := range m.Endpoints() {
+		if closer, ok := endpoint.(interface{ CloseBeforeStart() error }); ok {
+			_ = closer.CloseBeforeStart()
+		}
+	}
+}
