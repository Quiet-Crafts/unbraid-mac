--- /dev/null
+++ b/dns/transport/local/systemconfig/source_darwin_test.go
@@ -0,0 +1,67 @@
+//go:build cgo && darwin
+
+package systemconfig
+
+import (
+	"net/netip"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-tun/dnsinfo"
+)
+
+func serverStrings(config *Config) []string {
+	var servers []string
+	for _, server := range config.Servers {
+		servers = append(servers, server.String())
+	}
+	return servers
+}
+
+func addrPorts(addresses ...string) []netip.AddrPort {
+	var ports []netip.AddrPort
+	for _, address := range addresses {
+		ports = append(ports, netip.MustParseAddrPort(address))
+	}
+	return ports
+}
+
+// A network's IPv4 resolvers are asked first, each family keeping its own order, ports and zones.
+func TestNewConfigAsksIPv4ResolversFirst(t *testing.T) {
+	for _, testCase := range []struct {
+		name    string
+		servers []string
+		want    []string
+	}{
+		{"ipv6 listed first", []string{"[2001:4860:4860::8888]:53", "[2001:4860:4860::8844]:53", "8.8.8.8:53", "8.8.4.4:53"},
+			[]string{"8.8.8.8:53", "8.8.4.4:53", "[2001:4860:4860::8888]:53", "[2001:4860:4860::8844]:53"}},
+		{"interleaved", []string{"[fe80::1%en0]:53", "192.168.178.1:53", "[2001:db8::53]:5353", "[::ffff:10.0.0.1]:53", "9.9.9.9:5353"},
+			[]string{"192.168.178.1:53", "[::ffff:10.0.0.1]:53", "9.9.9.9:5353", "[fe80::1%en0]:53", "[2001:db8::53]:5353"}},
+		{"ipv4 only", []string{"192.168.178.1:53", "1.1.1.1:53"}, []string{"192.168.178.1:53", "1.1.1.1:53"}},
+		{"ipv6 only", []string{"[2001:db8::2]:53", "[2001:db8::1]:53"}, []string{"[2001:db8::2]:53", "[2001:db8::1]:53"}},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			resolver := dnsinfo.Resolver{Servers: addrPorts(testCase.servers...), Search: []string{"example.com"}, Timeout: 3 * time.Second}
+			before := slices.Clone(resolver.Servers)
+			config := newConfig(resolver)
+			if got := serverStrings(config); !slices.Equal(got, testCase.want) {
+				t.Fatalf("servers %v, want %v", got, testCase.want)
+			}
+			if !slices.Equal(resolver.Servers, before) {
+				t.Fatal("the resolver's own list was reordered")
+			}
+			if !slices.Equal(config.Search, []string{"example.com."}) || config.Timeout != 3*time.Second || config.Attempts != 2 || config.Ndots != 1 {
+				t.Fatalf("other settings changed: %+v", config)
+			}
+		})
+	}
+}
+
+// A network with no resolvers keeps the loopback defaults, IPv4 first as before.
+func TestNewConfigWithoutResolvers(t *testing.T) {
+	config := newConfig(dnsinfo.Resolver{})
+	if got := serverStrings(config); !slices.Equal(got, []string{"127.0.0.1:53", "[::1]:53"}) {
+		t.Fatalf("servers %v", got)
+	}
+}
