+// Unbraid: why the order of the network's resolvers matters (systemconfig asks IPv4 ones first). They are asked one
+// after another, each for a whole attempt timeout, so one that never answers ahead of one that does uses up the lookup.
+func TestSilentFirstResolverUsesUpTheLookup(t *testing.T) {
+	silent, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer silent.Close()
+	answering, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer answering.Close()
+	go func() {
+		buffer := make([]byte, 2048)
+		for {
+			n, from, readErr := answering.ReadFromUDP(buffer)
+			if readErr != nil {
+				return
+			}
+			var query mDNS.Msg
+			if query.Unpack(buffer[:n]) != nil {
+				continue
+			}
+			response := new(mDNS.Msg)
+			response.SetReply(&query)
+			response.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: query.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60}, A: net.IPv4(192, 0, 2, 1)}}
+			packed, _ := response.Pack()
+			answering.WriteToUDP(packed, from)
+		}
+	}()
+	address := func(conn *net.UDPConn) M.Socksaddr {
+		return M.SocksaddrFromNetIP(netip.MustParseAddrPort(conn.LocalAddr().String()))
+	}
+	lookup := func(servers ...M.Socksaddr) error {
+		config := &systemconfig.Config{Servers: servers, Timeout: 5 * time.Second, Attempts: 2, Ndots: 1}
+		scope := adapter.NewScope(context.Background(), logger.NOP())
+		defer scope.Close()
+		set := &localServerSet{config: config, serverScope: scope}
+		for _, server := range servers {
+			udp := transport.NewUDPRaw(logger.NOP(), dns.NewTransportAdapter(C.DNSTypeUDP, "", nil), N.SystemDialer, server)
+			if startErr := udp.Start(adapter.StartStateStart, scope); startErr != nil {
+				return startErr
+			}
+			set.transports = append(set.transports, udp)
+		}
+		message := new(mDNS.Msg)
+		message.SetQuestion("example.com.", mDNS.TypeA)
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		done := make(chan error, 1)
+		newNameExchanger(config, set, message, "example.com.")(ctx, func(response *mDNS.Msg, exchangeErr error) {
+			if exchangeErr == nil && len(response.Answer) == 0 {
+				exchangeErr = context.Canceled
+			}
+			done <- exchangeErr
+		})
+		return <-done
+	}
+	if err := lookup(address(silent), address(answering)); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("a silent first resolver should use up the lookup, got %v", err)
+	}
+	if err := lookup(address(answering), address(silent)); err != nil {
+		t.Fatalf("an answering first resolver: %v", err)
+	}
+}
