+func tcpSYN(src, dst netip.AddrPort) []byte {
+	packet := make([]byte, 4+header.IPv4MinimumSize+header.TCPMinimumSize)
+	binary.BigEndian.PutUint32(packet, syscall.AF_INET)
+	ip := header.IPv4(packet[4:])
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: uint16(len(ip)), TTL: 64, ID: 1, Protocol: uint8(header.TCPProtocolNumber),
+		SrcAddr: tcpip.AddrFrom4(src.Addr().As4()), DstAddr: tcpip.AddrFrom4(dst.Addr().As4()),
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	tcp := header.TCP(ip.Payload())
+	tcp.Encode(&header.TCPFields{SrcPort: src.Port(), DstPort: dst.Port(), SeqNum: 1000, DataOffset: header.TCPMinimumSize,
+		Flags: header.TCPFlagSyn, WindowSize: 65535})
+	pseudo := header.PseudoHeaderChecksum(header.TCPProtocolNumber, ip.SourceAddress(), ip.DestinationAddress(), uint16(len(tcp)))
+	tcp.SetChecksum(^tcp.CalculateChecksum(pseudo))
+	return packet
+}
+
+func udpDatagram(src, dst netip.AddrPort) []byte {
+	packet := make([]byte, 4+header.IPv4MinimumSize+header.UDPMinimumSize+1)
+	binary.BigEndian.PutUint32(packet, syscall.AF_INET)
+	ip := header.IPv4(packet[4:])
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: uint16(len(ip)), TTL: 64, ID: 1, Protocol: uint8(header.UDPProtocolNumber),
+		SrcAddr: tcpip.AddrFrom4(src.Addr().As4()), DstAddr: tcpip.AddrFrom4(dst.Addr().As4()),
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	udp := header.UDP(ip.Payload())
+	udp.Encode(&header.UDPFields{SrcPort: src.Port(), DstPort: dst.Port(), Length: uint16(len(udp))})
+	udp.Payload()[0] = 42
+	pseudo := header.PseudoHeaderChecksum(header.UDPProtocolNumber, ip.SourceAddress(), ip.DestinationAddress(), uint16(len(udp)))
+	udp.SetChecksum(^udp.CalculateChecksum(checksumOf(udp.Payload(), pseudo)))
+	return packet
+}
+
+func checksumOf(payload []byte, initial uint16) uint16 {
+	sum := uint32(initial)
+	for i := 0; i+1 < len(payload); i += 2 {
+		sum += uint32(payload[i])<<8 | uint32(payload[i+1])
+	}
+	if len(payload)%2 == 1 {
+		sum += uint32(payload[len(payload)-1]) << 8
+	}
+	for sum > 0xffff {
+		sum = sum>>16 + sum&0xffff
+	}
+	return uint16(sum)
+}
