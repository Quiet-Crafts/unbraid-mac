+// A TUN device the test owns: one end of a datagram socket pair, framed like utun (a 4-byte address family first).
+type socketTunPlatform struct {
+	adapter.PlatformInterface // anything not overridden below is not expected to be called
+	fd                        int
+}
+
+func (p *socketTunPlatform) Initialize(adapter.NetworkManager) error     { return nil }
+func (p *socketTunPlatform) UsePlatformAutoDetectInterfaceControl() bool { return false }
+func (p *socketTunPlatform) UsePlatformInterface() bool                  { return true }
+func (p *socketTunPlatform) OpenInterface(options *tun.Options, _ option.TunPlatformOptions) (tun.Tun, error) {
+	options.FileDescriptor = p.fd
+	options.EXP_ExternalConfiguration = true
+	options.EXP_MultiPendingPackets = false // a utun socket option
+	return tun.New(*options)
+}
