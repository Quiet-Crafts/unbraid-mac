diff --git a/dns/transport/fakeip/store_test.go b/dns/transport/fakeip/store_test.go
new file mode 100644
index 0000000..4dac348
--- /dev/null
+++ b/dns/transport/fakeip/store_test.go
@@ -0,0 +1,55 @@
+package fakeip
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing/common/logger"
+)
+
+func TestStoreNeverReusesAnAddress(t *testing.T) {
+	store := NewStore(context.Background(), logger.NOP(), netip.MustParsePrefix("198.18.0.0/28"), netip.Prefix{})
+	if left := Remaining(); left != -1 {
+		t.Fatalf("remaining %d before start, want -1", left)
+	}
+	if err := store.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if left := Remaining(); left != 13 {
+		t.Fatalf("remaining %d, want 13", left)
+	}
+	seen := map[netip.Addr]string{}
+	for i := 0; i < 13; i++ {
+		name := fmt.Sprint("n", i, ".example")
+		address, err := store.Create(name, false)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if other, used := seen[address]; used {
+			t.Fatalf("%s given %s, already %s's", name, address, other)
+		}
+		seen[address] = name
+	}
+	if left := Remaining(); left != 0 {
+		t.Fatalf("remaining %d, want 0", left)
+	}
+	if _, err := store.Create("late.example", false); err != ErrExhausted {
+		t.Fatalf("late lookup: %v, want ErrExhausted", err)
+	}
+	for address, name := range seen {
+		if again, err := store.Create(name, false); err != nil || again != address {
+			t.Fatalf("%s now %s (%v), want %s", name, again, err, address)
+		}
+		if owner, _ := store.Lookup(address); owner != name {
+			t.Fatalf("%s maps to %s, want %s", address, owner, name)
+		}
+	}
+	if err := store.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if left := Remaining(); left != -1 {
+		t.Fatalf("remaining %d after close, want -1", left)
+	}
+}
