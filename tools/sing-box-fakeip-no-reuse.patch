+++ b/experimental/libbox/fakeip.go
@@ -0,0 +1,9 @@
+package libbox
+
+import "github.com/sagernet/sing-box/dns/transport/fakeip"
+
+// FakeIPRemaining is how many stand-in addresses the running engine can still hand out before lookups of new names
+// fail, or -1 when no fake-IP store runs.
+func FakeIPRemaining() int32 {
+	return fakeip.Remaining()
+}
