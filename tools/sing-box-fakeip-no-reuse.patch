@@ -2,8 +2,11 @@ package fakeip
 
 import (
 	"context"
+	"math"
+	"math/big"
 	"net/netip"
 	"sync"
+	"sync/atomic"
 
 	"github.com/sagernet/sing-box/adapter"
 	E "github.com/sagernet/sing/common/exceptions"
@@ -13,6 +16,47 @@ import (
 
 var _ adapter.FakeIPStore = (*Store)(nil)
 
+// ErrExhausted: every address of the range has been handed out. An address is never handed to a second name while the
+// store keeps its range (a program still holding it would have its connections taken for the other name's), so lookups
+// of new names fail until the range changes.
+var ErrExhausted = E.New("fakeip address range exhausted")
+
+// The store that started last and is still open, for Remaining.
+var running atomic.Pointer[Store]
+
+// Remaining is how many addresses the running store can still hand out (the fewer of its IPv4 and IPv6 ranges, at most
+// math.MaxInt32), or -1 when no store runs.
+func Remaining() int32 {
+	s := running.Load()
+	if s == nil {
+		return -1
+	}
+	s.addressAccess.Lock()
+	defer s.addressAccess.Unlock()
+	left := int64(math.MaxInt32)
+	if s.inet4Current.IsValid() {
+		left = min(left, addressesBetween(s.inet4Current, s.inet4Last))
+	}
+	if s.inet6Current.IsValid() {
+		left = min(left, addressesBetween(s.inet6Current, s.inet6Last))
+	}
+	return int32(left)
+}
+
+// The addresses strictly between current (the last handed out) and last (the broadcast address, never handed out).
+func addressesBetween(current netip.Addr, last netip.Addr) int64 {
+	a, b := current.As16(), last.As16()
+	n := new(big.Int).Sub(new(big.Int).SetBytes(b[:]), new(big.Int).SetBytes(a[:]))
+	n.Sub(n, big.NewInt(1))
+	if n.Sign() < 0 {
+		return 0
+	}
+	if !n.IsInt64() {
+		return math.MaxInt32
+	}
+	return min(n.Int64(), math.MaxInt32)
+}
+
