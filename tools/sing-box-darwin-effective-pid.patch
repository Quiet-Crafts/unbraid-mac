diff --git a/common/process/searcher_darwin_shared_test.go b/common/process/searcher_darwin_shared_test.go
new file mode 100644
index 0000000..22d47a2
--- /dev/null
+++ b/common/process/searcher_darwin_shared_test.go
@@ -0,0 +1,184 @@
+//go:build darwin
+
+package process
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"testing"
+	"time"
+
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Unbraid: a socket's effective owner wins, and the process that last used it stands in once that owner has gone.
+
+func darwinTestSocket(t *testing.T, lastPID uint32, effectivePID uint32) darwinConnectionEntry {
+	t.Helper()
+	inp := make([]byte, darwinXsocketOffset)
+	so := make([]byte, structSize-darwinXsocketOffset)
+	binary.BigEndian.PutUint16(inp[darwinXinpcbForeignPort:], 443)
+	binary.BigEndian.PutUint16(inp[darwinXinpcbLocalPort:], 50000)
+	inp[darwinXinpcbVFlag] = 0x1
+	copy(inp[darwinXinpcbForeignAddr+darwinXinpcbIPv4Addr:], []byte{203, 0, 113, 5})
+	copy(inp[darwinXinpcbLocalAddr+darwinXinpcbIPv4Addr:], []byte{10, 0, 0, 2})
+	binary.NativeEndian.PutUint32(so[darwinXsocketUID:], 501)
+	binary.NativeEndian.PutUint32(so[darwinXsocketLastPID:], lastPID)
+	binary.NativeEndian.PutUint32(so[darwinXsocketEffectivePID:], effectivePID)
+	entry, ok := parseDarwinConnectionEntry(inp, so)
+	if !ok {
+		t.Fatal("socket not parsed")
+	}
+	return entry
+}
+
+func TestDarwinEntryKeepsBothOwners(t *testing.T) {
+	for _, c := range []struct {
+		last, effective, pid uint32
+	}{
+		{last: 10, effective: 0, pid: 10},
+		{last: 10, effective: 20, pid: 20},
+		{last: 10, effective: 10, pid: 10},
+		{last: 10, effective: 0xFFFFFFFF, pid: 10},
+		{last: 0, effective: 0, pid: 0},
+	} {
+		entry := darwinTestSocket(t, c.last, c.effective)
+		if entry.pid != c.pid || entry.lastPID != c.last || entry.uid != 501 {
+			t.Errorf("last %d effective %d: pid %d, last %d, uid %d", c.last, c.effective, entry.pid, entry.lastPID, entry.uid)
+		}
+		if entry.remoteAddr != netip.MustParseAddr("203.0.113.5") || entry.localPort != 50000 || entry.remotePort != 443 {
+			t.Errorf("addresses: %v", entry)
+		}
+	}
+}
+
+type darwinTestFinder struct {
+	*darwinConnectionFinder
+	builds  int
+	lookups []uint32
+}
+
+func newDarwinTestFinder(t *testing.T, entry darwinConnectionEntry, paths map[uint32]string) *darwinTestFinder {
+	f := &darwinTestFinder{darwinConnectionFinder: newDarwinConnectionFinder(time.Hour)}
+	f.builder = func(string) (darwinSnapshot, error) {
+		f.builds++
+		return darwinSnapshot{createdAt: time.Now(), entries: []darwinConnectionEntry{entry}}, nil
+	}
+	f.execPath = func(pid uint32) (string, error) {
+		f.lookups = append(f.lookups, pid)
+		if path, ok := paths[pid]; ok {
+			return path, nil
+		}
+		return "", errors.New("no such process")
+	}
+	return f
+}
+
+func (f *darwinTestFinder) owner(t *testing.T) (string, int32) {
+	t.Helper()
+	owner, err := f.find(N.NetworkTCP, netip.MustParseAddrPort("10.0.0.2:50000"), netip.MustParseAddrPort("203.0.113.5:443"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return owner.ProcessPath, owner.UserId
+}
+
+func equalPIDs(a, b []uint32) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestDarwinOwnerFallsBackToTheLastPID(t *testing.T) {
+	app, helper := "/Applications/App.app/Contents/MacOS/App", "/usr/libexec/nsurlsessiond"
+	for _, c := range []struct {
+		name    string
+		paths   map[uint32]string
+		want    string
+		lookups []uint32
+	}{
+		{"effective owner runs", map[uint32]string{20: app, 10: helper}, app, []uint32{20}},
+		{"effective owner gone", map[uint32]string{10: helper}, helper, []uint32{20, 10}},
+		{"both gone", map[uint32]string{}, "", []uint32{20, 10}},
+		{"an empty path is no path", map[uint32]string{20: "", 10: helper}, helper, []uint32{20, 10}},
+	} {
+		f := newDarwinTestFinder(t, darwinTestSocket(t, 10, 20), c.paths)
+		path, uid := f.owner(t)
+		if path != c.want || uid != 501 || !equalPIDs(f.lookups, c.lookups) || f.builds != 1 {
+			t.Errorf("%s: path %q uid %d lookups %v builds %d", c.name, path, uid, f.lookups, f.builds)
+		}
+	}
+}
+
+func TestDarwinOwnerRefreshesBeforeFallingBack(t *testing.T) {
+	f := newDarwinTestFinder(t, darwinTestSocket(t, 10, 20), map[uint32]string{10: "/usr/libexec/nsurlsessiond"})
+	f.owner(t)
+	f.lookups = nil
+	// From the cached snapshot the effective owner's path fails: the snapshot is taken again before the last pid stands in.
+	path, _ := f.owner(t)
+	if path != "/usr/libexec/nsurlsessiond" || f.builds != 2 || !equalPIDs(f.lookups, []uint32{20, 20, 10}) {
+		t.Errorf("path %q builds %d lookups %v", path, f.builds, f.lookups)
+	}
+}
+
+func TestDarwinOwnerWithoutPIDsHasNoPath(t *testing.T) {
+	f := newDarwinTestFinder(t, darwinTestSocket(t, 0, 0), map[uint32]string{0: "/kernel"})
+	path, uid := f.owner(t)
+	if path != "" || uid != 501 || len(f.lookups) != 0 {
+		t.Errorf("path %q uid %d lookups %v", path, uid, f.lookups)
+	}
+}
+
+func TestDarwinOwnerSamePIDsAskedOnce(t *testing.T) {
+	f := newDarwinTestFinder(t, darwinTestSocket(t, 10, 10), map[uint32]string{})
+	path, _ := f.owner(t)
+	if path != "" || !equalPIDs(f.lookups, []uint32{10}) {
+		t.Errorf("path %q lookups %v", path, f.lookups)
+	}
+}
+
+func TestDarwinOwnerAfterRefreshUsesOnlyTheFreshSocket(t *testing.T) {
+	cached := darwinTestSocket(t, 10, 20)
+	paths := map[uint32]string{10: "/usr/libexec/nsurlsessiond", 30: "/Applications/Other.app/Contents/MacOS/Other"}
+	for _, c := range []struct {
+		name    string
+		fresh   func() (darwinSnapshot, error)
+		want    string
+		fails   bool
+		lookups []uint32
+	}{
+		{"socket now someone else's", func() (darwinSnapshot, error) {
+			return darwinSnapshot{createdAt: time.Now(), entries: []darwinConnectionEntry{darwinTestSocket(t, 40, 30)}}, nil
+		}, paths[30], false, []uint32{20, 30}},
+		{"socket gone", func() (darwinSnapshot, error) {
+			return darwinSnapshot{createdAt: time.Now()}, nil
+		}, "", true, []uint32{20}},
+		{"snapshot fails", func() (darwinSnapshot, error) {
+			return darwinSnapshot{}, errors.New("sysctl")
+		}, "", true, []uint32{20}},
+	} {
+		f := newDarwinTestFinder(t, cached, paths)
+		f.owner(t)
+		f.lookups = nil
+		f.builder = func(string) (darwinSnapshot, error) { f.builds++; return c.fresh() }
+		owner, err := f.find(N.NetworkTCP, netip.MustParseAddrPort("10.0.0.2:50000"), netip.MustParseAddrPort("203.0.113.5:443"))
+		if c.fails {
+			if err == nil {
+				t.Errorf("%s: owner %v", c.name, owner)
+			}
+		} else if err != nil || owner.ProcessPath != c.want {
+			t.Errorf("%s: owner %v err %v", c.name, owner, err)
+		}
+		// The cached socket's last pid never stands in once a fresh snapshot says otherwise.
+		if !equalPIDs(f.lookups, c.lookups) || f.builds != 2 {
+			t.Errorf("%s: lookups %v builds %d", c.name, f.lookups, f.builds)
+		}
+	}
+}
