# Made-up profile in the shape of AirVPN's generator output, with throwaway test material only.
client
dev tun
remote 1.2.3.5 443
proto tcp
resolv-retry infinite
nobind
persist-key
persist-tun
auth-nocache
verb 3

keepalive 10 60
reneg-sec 3600
push-peer-info
setenv UV_IPV6 yes
remote-cert-tls server
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-256-CBC:AES-192-GCM:AES-192-CBC:AES-128-GCM:AES-128-CBC:CHACHA20-POLY1305
data-ciphers-fallback AES-256-CBC
auth SHA512
